# Provider secrets belong in backend/.env locally and Render Environment in production.
# The frontend uses same-origin /api requests; there are no public API keys.
PORT=3000

# Free-tier protection (protective budgets, not provider quota guarantees)
LLM_CALLS_PER_MINUTE=4
LLM_CALLS_PER_DAY=100
GLOBAL_REQUESTS_PER_MINUTE=60
GLOBAL_REQUESTS_PER_DAY=500
# Optional separate operations token; falls back to BENCHMARK_TOKEN
MONITORING_TOKEN=
# Set to a persistent writable path if a disk is available
OPERATIONS_DB=/tmp/nivaar-operations.sqlite3

# Evidence cache TTL by source type; original retrieval time is preserved.
SOURCE_CACHE_TTL_SECONDS=900
SOURCE_CACHE_PDF_TTL_SECONDS=900
