# Choose exactly one AI provider and supply its key. Defaults below are configurable.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# OpenAI default: gpt-4o-mini; Groq default: llama-3.3-70b-versatile
# Blank LLM_MODEL selects the provider's default.
TAVILY_API_KEY=
BRAVE_API_KEY=
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SPEAKER=shubh
GOOGLE_SAFE_BROWSING_KEY=
# Explicitly consent in the UI before sending images/audio to providers.
REQUIRE_LIVE_PROVIDERS=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=20
BENCHMARK_TOKEN=
MAX_CONCURRENT_ANALYSES=4
REPORT_TTL_SECONDS=3600

# Evidence cache TTL by source type; original retrieval time is preserved.
SOURCE_CACHE_TTL_SECONDS=900
SOURCE_CACHE_PDF_TTL_SECONDS=900

# Protective app budget, not a provider entitlement
LLM_CALLS_PER_MINUTE=4

# Protective daily budget
LLM_CALLS_PER_DAY=100

# Single-instance global abuse budget
GLOBAL_REQUESTS_PER_MINUTE=60

# Single-instance daily abuse budget
GLOBAL_REQUESTS_PER_DAY=500

# Optional separate operations token; otherwise BENCHMARK_TOKEN
MONITORING_TOKEN=

# Use a persistent writable disk for durability across replacement
OPERATIONS_DB=/tmp/nivaar-operations.sqlite3
