# Choose exactly one AI provider and supply its key. Defaults below are configurable.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# OpenAI default: gpt-4o-mini; Groq default: llama-3.3-70b-versatile
# Blank LLM_MODEL selects the provider's default.
TAVILY_API_KEY=
BRAVE_API_KEY=
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SPEAKER=shubh
GOOGLE_SAFE_BROWSING_KEY=
# Explicitly consent in the UI before sending images/audio to providers.
REQUIRE_LIVE_PROVIDERS=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=20
BENCHMARK_TOKEN=
MAX_CONCURRENT_ANALYSES=4
REPORT_TTL_SECONDS=3600
