{
  "name": "nivaar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "dev:web": "next dev --webpack",
    "dev:api": ".venv/bin/python -m uvicorn backend.main:app --reload --host 127.0.0.1 --port 8000",
    "build": "next build --webpack",
    "start": "node scripts/run.mjs start",
    "typecheck": "tsc --noEmit",
    "test": ".venv/bin/python -m pytest backend/tests -q",
    "test:providers": ".venv/bin/python -m backend.verify_providers",
    "test:voice": "node --test lib/voice.test.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "^1.31.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}
